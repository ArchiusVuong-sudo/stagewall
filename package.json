{
  "name": "stagewall",
  "version": "0.1.0",
  "private": true,
  "description": "A live fan message wall for a listening party: server-side scrubbing, AI screening with human review, fan self-delete. Synthetic demo data.",
  "author": "Khanh Vuong Tuan",
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p ${PORT:-4113}",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p ${PORT:-4113}",
    "start:replay": "DEMO_REPLAY=1 next start -H 127.0.0.1 -p ${PORT:-4113}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "LIVE=1 vitest run tests/live",
    "reset": "tsx scripts/reset.ts",
    "purge": "tsx scripts/purge.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:replay": "DEMO_REPLAY=1 tsx scripts/eval.ts",
    "record": "tsx scripts/record-fixtures.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "better-sqlite3": "^13.0.3",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@^0.2.17"
    }
  }
}
