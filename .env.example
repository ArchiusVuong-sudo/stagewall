# Copy to .env.local if you want to change anything. Everything is optional.

# Port for npm start / npm run dev (binds 127.0.0.1)
PORT=4113

# 1 = replay recorded live responses (no login or key needed)
DEMO_REPLAY=

# offline = keyword rules only, no AI
SCREENER=

# claude-sonnet-5-5 (default), claude-opus-5-5 or claude-haiku-5-5
SCREENER_MODEL=claude-sonnet-5-5

# Optional: use an API key instead of the local Claude Code login
ANTHROPIC_API_KEY=

# Where the SQLite file lives
DATA_DIR=./data

# Messages per device per 5 minutes
RATE_LIMIT_MAX=3

# 1 = key the rate limit on X-Forwarded-For (only behind a proxy that overwrites it)
TRUST_PROXY=
